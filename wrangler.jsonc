{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lms",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "talha-cie-study-db",
      "database_id": "7e9b51af-9452-43a6-961f-8ca167e2342d",
      "migrations_dir": "./drizzle"
    }
  ],
  "observability": {
    "enabled": true
  }
}
